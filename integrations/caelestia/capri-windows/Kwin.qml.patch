+    function capriAi(win): var {
+        const text = `${win.title || ''} ${win.class || ''} ${win.resourceClass || ''}`;
+        const patterns = [
+            ['chatgpt', /chatgpt/i],
+            ['claude', /claude/i],
+            ['codex', /codex/i],
+            ['opencode', /opencode/i],
+            ['gemini', /gemini/i],
+            ['copilot', /copilot/i],
+            ['perplexity', /perplexity/i],
+            ['deepseek', /deepseek/i],
+            ['grok', /grok/i],
+            ['lechat', /le chat|mistral ai/i],
+            ['characterai', /character\.ai/i],
+            ['metaai', /meta ai/i],
+        ];
+        return patterns.filter(pair => pair[1].test(text)).map(pair => pair[0]);
+    }
