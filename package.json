{
  "name": "simply-capri",
  "version": "0.5.0",
  "description": "Simply Capri — a fork of Capri Desktop with unified settings, shared-memory thoughts, Spotify control and the Caelestia Home Assistant add-on.",
  "author": "mochiiwuff",
  "repository": "github:s1mplym4tt/simply-capri",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "demo": "node scripts/demo.js",
    "hooks:install": "node scripts/install-hooks.js",
    "hooks:uninstall": "node scripts/install-hooks.js --uninstall",
    "hooks:codex:install": "node scripts/install-codex-hooks.js",
    "hooks:codex:uninstall": "node scripts/install-codex-hooks.js --uninstall",
    "hooks:agy:install": "node scripts/install-hooks-agy.js",
    "hooks:agy:uninstall": "node scripts/install-hooks-agy.js --uninstall",
    "check:llm": "node scripts/check-llm.js",
    "test:hooks": "node --test tests/hooks.test.js",
    "dist": "electron-builder --win"
  },
  "keywords": [
    "claude-code",
    "desktop-pet",
    "electron",
    "cyberpunk",
    "edgerunners"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0"
  },
  "build": {
    "appId": "dev.s1mplym4tt.simplycapri",
    "productName": "Simply Capri",
    "files": [
      "src/**",
      "assets/**",
      "hooks/**",
      "scripts/**",
      "package.json",
      "LICENSE",
      "integrations/**"
    ],
    "asarUnpack": [
      "hooks/**",
      "src/main/windows.ps1",
      "integrations/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/capri.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "Simply Capri",
      "artifactName": "Simply-Capri-Setup-${version}.${ext}"
    }
  },
  "contributors": [
    {
      "name": "s1mplym4tt",
      "url": "https://github.com/s1mplym4tt"
    }
  ]
}
